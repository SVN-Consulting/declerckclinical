        "sql": "CREATE TABLE \"public\".\"Service\" (\n  \"content\" text[] NOT NULL,\n  \"createdAt\" timestamptz(3) NOT NULL,\n  \"header\" text NOT NULL,\n  \"id\" text NOT NULL,\n  \"updatedAt\" timestamptz(3) NOT NULL,\n  PRIMARY KEY (\"id\"),\n  CONSTRAINT \"Service_content_elem_not_null_1b2eb5ab\" CHECK (array_position(\"content\", NULL) IS NULL)\n)",
        "params": []
      }
    ],
